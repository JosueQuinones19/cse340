<div class="form-container">
    <h1>
        <%= title %>
    </h1>
    <%- messages() %>

        <form id="updateForm" action="/inv/update" method="post">
            <label>Classification:</label>
            <%- classificationSelect %>

                <label for="inv_make">Make:</label>
                <input type="text" name="inv_make" id="inv_make" required value="<%= locals.inv_make %>">

                <label for="inv_model">Model:</label>
                <input type="text" name="inv_model" id="inv_model" required value="<%= locals.inv_model %>">

                <label for="inv_year">Year:</label>
                <input type="number" name="inv_year" id="inv_year" required min="1900" max="2099"
                    value="<%= locals.inv_year %>">

                <label for="inv_description">Description:</label>
                <textarea name="inv_description" required><%= locals.inv_description %></textarea>

                <label for="inv_image">Image Path:</label>
                <input type="text" name="inv_image" value="<%= locals.inv_image %>" required>

                <label for="inv_thumbnail">Thumbnail Path:</label>
                <input type="text" name="inv_thumbnail" value="<%= locals.inv_thumbnail %>" required>

                <label for="inv_price">Price:</label>
                <input type="number" name="inv_price" required value="<%= locals.inv_price %>">

                <label for="inv_miles">Miles:</label>
                <input type="number" name="inv_miles" required value="<%= locals.inv_miles %>">

                <label for="inv_color">Color:</label>
                <input type="text" name="inv_color" required value="<%= locals.inv_color %>">

                <button type="submit" disabled>Update Vehicle</button>

                <input type="hidden" name="inv_id" <% if(locals.inv_id) { %> value="<%= locals.inv_id %>" <% } %>>
        </form>
</div>

<script src="/js/inv-update.js"></script>