<div class="form-container">
    <h1>
        <%= title %>
    </h1>
    <%- messages() %>
        <% if (errors) { %>
            <ul class="notice">
                <% errors.array().forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <form action="/inv/add-classification" method="post">
                    <p>NOTE: The classification name must be a single word, no spaces, and no special characters.</p>
                    <div class="form-group">
                        <label for="classification_name">Classification Name:</label>
                        <input type="text" id="classification_name" name="classification_name" required
                            pattern="^[a-zA-Z0-9]+$" title="No spaces or special characters allowed">
                    </div>
                    <button type="submit" class="submit-btn">Add Classification</button>
                </form>
</div>